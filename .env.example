# Copy to `.env`. Secrets only -- everything else belongs in
# astrocontroller.toml. `.env` is gitignored and is never read by tooling
# other than the app itself; an already-exported variable always wins.

# Shared secret for the dashboard. REQUIRED when [server].host is not
# loopback, because the UI can stop a running sequence and neither NINA's API
# nor PHD2 has any authentication of its own.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(16))"
ASTROCONTROLLER_TOKEN=

# Only needed when [llm].model uses the matching provider.
# Ollama needs no key.
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
